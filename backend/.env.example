# Copia este archivo a .env para desarrollo local sin Docker.
DEBUG=true
SECRET_KEY=dev-insecure-change-me
# Sin DATABASE_URL se usa SQLite; sin REDIS_URL, canales en memoria y Celery en línea.
# DATABASE_URL=postgres://trueke:trueke@localhost:5432/trueke
# REDIS_URL=redis://localhost:6379/0
OTP_PROVIDER=console
PHONE_DEFAULT_REGION=CO
# S3 o compatible (producción; sin S3_BUCKET se usa el disco)
# S3_BUCKET=trueke
# S3_ENDPOINT_URL=https://<endpoint>   # solo para proveedores distintos de AWS
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Publicaciones
# LISTING_IMAGE_MAX_MB=8
# LISTING_MAX_IMAGES=10
# LISTING_CURRENCY=COP
